# Base URL for the NetraTrust API.
# Empty (the default) sends requests to a relative /v1 path, which the Vite dev
# server proxies to http://127.0.0.1:8000 - see `server.proxy` in vite.config.ts.
# Set it to http://localhost:8000 to bypass the proxy and talk to the API
# cross-origin, which exercises Lane A's CORS the way a deployed build will.
VITE_API_BASE=

# "1" serves every endpoint from the in-memory mock responder
# (src/lib/api/mock.ts), for working on screens with no backend running.
# ANY OTHER VALUE, INCLUDING UNSET, USES THE REAL API - that is the default.
# The mock is a fallback, not the normal path.
VITE_USE_MOCK=0
